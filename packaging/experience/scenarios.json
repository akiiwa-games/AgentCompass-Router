    {"name": "two-vendors-codex-outside-allowed", "accounts": [{"name": "claude", "family": "claude", "plan": "max5"}, {"name": "codex", "family": "codex", "plan": "plus"}], "usage": "fresh", "switches": {"outside_allowed": ["codex"]}, "days": 1},
