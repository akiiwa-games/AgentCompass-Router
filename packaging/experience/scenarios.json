    {"name": "two-vendors-fresh", "accounts": [{"name": "claude", "family": "claude", "plan": "pro"}, {"name": "codex", "family": "codex", "plan": "plus"}], "usage": "fresh", "days": 1},
    {"name": "two-vendors-main-nearly-empty", "accounts": [{"name": "claude", "family": "claude", "plan": "max5"}, {"name": "codex", "family": "codex", "plan": "plus"}], "usage": "mid_period", "usage_by_account": {"claude": "nearly_empty"}, "days": 1},
    {"name": "two-vendors-short-window-empty", "accounts": [{"name": "claude", "family": "claude", "plan": "max20"}, {"name": "codex", "family": "codex", "plan": "plus"}], "usage": "short_empty", "days": 1},
    {"name": "large-fleet-mid", "accounts": [{"name": "claude", "family": "claude", "plan": "max20"}, {"name": "claude-2", "family": "claude", "plan": "pro"}, {"name": "codex", "family": "codex", "plan": "pro"}, {"name": "codex-2", "family": "codex", "plan": "plus"}, {"name": "opencode", "family": "opencode"}], "usage": "mid_period", "days": 1},
    {"name": "large-fleet-everything-scarce", "accounts": [{"name": "claude", "family": "claude", "plan": "max20"}, {"name": "claude-2", "family": "claude", "plan": "pro"}, {"name": "codex", "family": "codex", "plan": "pro"}, {"name": "codex-2", "family": "codex", "plan": "plus"}, {"name": "opencode", "family": "opencode"}], "usage": "scarce", "days": 1},
    {"name": "free-only", "accounts": [{"name": "opencode", "family": "opencode"}], "usage": "fresh", "days": 1},
